# Required: the address users open in the browser (https, no trailing path)
PUBLIC_URL=https://cars.example.org

# Optional (defaults shown) – see docs/configuration.md
# DEFAULT_TIMEZONE=UTC
# SESSION_IDLE_MINUTES=43200
# SESSION_ABSOLUTE_HOURS=2160
# FORWARDED_ALLOW_IPS=*
# LOG_LEVEL=INFO
# REGISTRATION=invite
# IMPRINT_URL=
# PRIVACY_URL=
# TERMS_URL=
# MAX_GROUPS_PER_USER=
# MAX_MEMBERS_PER_GROUP=
# MAX_CARS_PER_GROUP=

# Optional plans per group, for hosting it for others (docs/configuration.md#plans)
# PLANS_FILE=/config/plans.json
# BILLING_URL=https://example.org/plans
# OPERATOR_TOKEN_FILE=/run/secrets/fahrma_operator_token
# INACTIVE_DELETE_MONTHS=24

# Optional e-mail (forgot password, confirmed addresses, links by mail)
# MAIL_FROM=fahrma <noreply@cars.example.org>
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
